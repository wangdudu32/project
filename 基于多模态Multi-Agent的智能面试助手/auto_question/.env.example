# 在线模式：填写支持图片输入的兼容接口，地址应包含 /v1 等接口前缀。
MODEL_PROVIDER=remote
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT=120

# 本地模式：MODEL_PROVIDER=local，并安装 backend/requirements-local.txt。
# 相对路径以 auto_question 目录为准。
MODEL_PATH=models/qwen2.5vl
MODEL_DEVICE=auto
# 可选：加载 train/train_qgen.py 训练得到的 LoRA 适配器。
ADAPTER_PATH=

STORAGE_DIR=backend/storage
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_RESEARCH_URL=http://localhost:5183
# Vite 默认读取 BACKEND_PORT，也可单独指定代理：
# VITE_API_PROXY=http://127.0.0.1:8000

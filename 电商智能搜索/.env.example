# Copy only when creating a fresh checkout. Keep your existing .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.example.com/v1
# Leave empty to discover a suitable chat model through /models.
CHAT_MODEL=

OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_INDEX=seek_products
SEARCH_BACKEND=auto
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
MODEL_DEVICE=cpu
MODEL_TIMEOUT=45
EMBEDDING_ENABLED=true
RERANK_ENABLED=true
API_HOST=127.0.0.1
API_PORT=8000

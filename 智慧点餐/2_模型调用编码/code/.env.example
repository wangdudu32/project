# 不配置外部服务也能完成基础点餐。SQLite 数据文件默认放在 code 目录。
# DATABASE_URL=mysql+pymysql://用户名:密码@127.0.0.1:3306/aimenu?charset=utf8mb4
COOKIE_SECURE=false

# AI 相关功能按需开启，并安装 requirements-ai.txt
AI_ENABLED=false
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODE=qwen2.5-14b-instruct
PINECONE_ENABLED=false
PINECONE_API_KEY=
PINECONE_ENV=us-east-1
PINECONE_INDEX=aimenu-items

# 高德地图，可选。商家坐标必须与餐厅地址对应。
AMAP_ENABLED=false
AMAP_API_KEY=
MERCHANT_LONGITUDE=116.316
MERCHANT_LATITUDE=39.983
DELIVERY_RADIUS=2500
DEFAULT_PATH_MODE=2

RESTAURANT_NAME=小满餐厅
RESTAURANT_ADDRESS=北京市海淀区中关村
RESTAURANT_HOURS=每天 09:00-22:00
RESTAURANT_PHONE=请联系店内工作人员
